# Copy to .env (repo root) and fill in local values. No real secrets committed to git.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (Supabase Postgres, via the Session Pooler connection string) ---
DATABASE_URL=

# --- Supabase (used for the database always; used for file storage only when STORAGE_DRIVER=supabase) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=library-files

# --- Storage adapter: which provider actually holds the uploaded files ---
# r2 | supabase
STORAGE_DRIVER=r2

# --- Cloudflare R2 (only needed when STORAGE_DRIVER=r2 — see DECISIONS.md) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Session ---
SESSION_SECRET=replace-with-a-long-random-string

# --- Local admin credential (dev-only auth adapter; see DECISIONS.md D3) ---
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password, generate locally — never commit a plaintext password
ADMIN_PASSWORD_HASH=

# --- Upload limit (bytes) — direct-to-storage upload, so this is the only
# size limit; R2 also has no low per-object cap like Supabase Storage's 50MB ---
UPLOAD_RAW_MAX_BYTES=314572800

# --- AI librarian (per-book Q&A) — provider is pluggable via AI_PROVIDER ---
# groq | (future: gemini)
AI_PROVIDER=groq
GROQ_API_KEY=

# --- OCR (reads text off scanned PDFs and image posters, so they can be
# searched and asked about) — provider is pluggable via OCR_PROVIDER ---
# tesseract | none   ("none" turns OCR off entirely on a small instance)
OCR_PROVIDER=tesseract
# Tesseract language packs, downloaded once on first use (~15MB)
OCR_LANGS=tha+eng
# Where those packs are cached. Defaults to the system temp dir.
# OCR_CACHE_PATH=
# Ceilings, all optional — these are the defaults
# OCR_MAX_BYTES=62914560       # skip files larger than this (60MB)
# OCR_MAX_PAGES=250            # pages of one book to read
# OCR_MAX_EDGE_PX=2200         # longest edge fed to the engine
# OCR_TIME_BUDGET_MS=900000    # give up on one file after 15 minutes
